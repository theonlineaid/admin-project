# Copy this file to .env — defaults below work for Docker.

# Postgres (used by the postgres service and the app's DATABASE_URL)
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_secret
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432

# pgAdmin login
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# App
APP_PORT=3000

# NextAuth
# Set to a random string in production, e.g. `openssl rand -base64 32`
AUTH_SECRET=change-me-in-production
# http://localhost:3000 for local Docker
AUTH_URL=http://localhost:3000

# Prisma / app database connection (Docker Compose builds this from the
# POSTGRES_* vars above; set it directly if running the app outside Docker)
DATABASE_URL=postgresql://ecommerce:ecommerce_secret@localhost:5432/ecommerce?schema=public

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=dbawkayfv
CLOUDINARY_API_KEY=434376271249585
CLOUDINARY_API_SECRET=xEzT9CbdHZpVUuDX0EDRBvkUzA8
